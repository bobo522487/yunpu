# YUNPU_ENV allows only development or test.

# development
# database name yunpu_dev, app port 3000, database host port 5432, storage host port 9000
YUNPU_ENV=development
YUNPU_DATABASE_NAME=yunpu_dev
YUNPU_APP_PORT=3000
YUNPU_DATABASE_PORT=5432
YUNPU_STORAGE_PORT=9000
YUNPU_CAPABILITY_TOKEN=example-development-capability-token

# test
# database name yunpu_test, app port 3010, database host port 5433, storage host port 9010
# Copy this block on its own. Do not combine it with the development values above.
# YUNPU_ENV=test
# YUNPU_DATABASE_NAME=yunpu_test
# YUNPU_APP_PORT=3010
# YUNPU_DATABASE_PORT=5433
# YUNPU_STORAGE_PORT=9010
# YUNPU_CAPABILITY_TOKEN=example-test-capability-token

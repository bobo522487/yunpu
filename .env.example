# YUNPU_ENV allows only development or test.
# Values below are examples, not real secrets.

# development
# database name yunpu_dev, app port 3000, database host port 5432, storage host port 9000
YUNPU_ENV=development
DATABASE_URL=postgres://yunpu_owner:example@127.0.0.1:5432/yunpu_dev
PORT=3000
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=yunpu-dev
S3_ACCESS_KEY_ID=example-dev-access
S3_SECRET_ACCESS_KEY=example-dev-secret
YUNPU_CAPABILITY_TOKEN=example-development-capability-token

# test
# database name yunpu_test, app port 3010, database host port 5433, storage host port 9010
# Copy this block on its own. Do not combine it with the development values above.
# YUNPU_ENV=test
# DATABASE_URL=postgres://yunpu_owner:example@127.0.0.1:5433/yunpu_test
# PORT=3010
# S3_ENDPOINT=http://127.0.0.1:9010
# S3_BUCKET=yunpu-test
# S3_ACCESS_KEY_ID=example-test-access
# S3_SECRET_ACCESS_KEY=example-test-secret
# YUNPU_CAPABILITY_TOKEN=example-test-capability-token
